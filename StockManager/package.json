{
  "name": "marketing-services-stock-manager",
  "version": "2.0.0",
  "description": "Inventory, Billing & Load Form manager (Haramain / Moon Marketing Services)",
  "main": "main.js",
  "scripts": {
    "start": "cross-env BRAND=haramain electron .",
    "start:haramain": "cross-env BRAND=haramain electron .",
    "start:moon": "cross-env BRAND=moon electron .",
    "start:faisal": "cross-env BRAND=faisal electron .",
    "build:haramain": "cross-env BRAND=haramain electron-builder --win --config electron-builder.config.js",
    "build:moon": "cross-env BRAND=moon electron-builder --win --config electron-builder.config.js",
    "build:faisal": "cross-env BRAND=faisal electron-builder --win --config electron-builder.config.js",
    "build:all": "npm run build:haramain && npm run build:moon",
    "test": "node tests/run-all.js",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  }
}
